# ---------------------------------------------------------------------------
# MaxAI Crypto — frontend environment
#
# The frontend talks ONLY to the MaxAI backend. It never holds provider
# credentials (Zerion / Tatum / CoinGecko / OpenAI). Those live server-side.
# ---------------------------------------------------------------------------

# Base URL of the MaxAI REST API. The `/api/v1` prefix is appended by the
# API client, so this value is an origin or an empty string for same-origin.
VITE_API_BASE_URL=

# `mock`  -> in-memory adapter implementing the same contracts as the backend
# `real`  -> HTTP adapter against VITE_API_BASE_URL + /api/v1
VITE_API_MODE=mock

# Request timeout in milliseconds for non-streaming requests.
VITE_API_TIMEOUT_MS=15000

# Product analytics. Disabled by default; no vendor is bundled.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_DEBUG=false

# Dev-server proxy target used when VITE_API_MODE=real.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
