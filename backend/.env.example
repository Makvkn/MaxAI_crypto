# MaxAI Crypto backend configuration.
# Copy to .env for local development. Never commit a filled-in .env.
# Spec: MaxAI_Crypto_Backend_Spec.md §135.

# ---------------------------------------------------------------- application
APP_ENV=development
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_REQUEST_BYTES=1048576
LOG_LEVEL=debug
LOG_FORMAT=text

# CORS. Comma-separated exact origins; no wildcard in production (§150).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------- postgres
DATABASE_URL=postgres://maxai:maxai@localhost:5432/maxai?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_CONNECT_TIMEOUT=10s

# ---------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ----------------------------------------------------------------------- auth
# Minimum 32 bytes. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-development-secret-change-me-please
AUTH_JWT_ISSUER=maxai-crypto
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ------------------------------------------------------------------ providers
ZERION_API_KEY=
ZERION_BASE_URL=https://api.zerion.io
TATUM_API_KEY=
TATUM_BASE_URL=https://api.tatum.io
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

PROVIDER_TIMEOUT=15s
PROVIDER_MAX_ATTEMPTS=3
# Backoff schedule from §29: 30s -> 1m -> 5m.
PROVIDER_BACKOFF_SCHEDULE=30s,1m,5m

# ------------------------------------------------------------------------- ai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=60s
LLM_MAX_OUTPUT_TOKENS=1500
AI_MAX_TOOL_CALLS=5
AI_MAX_CONTEXT_MESSAGES=10
AI_DAILY_LIMIT=10

# ------------------------------------------------------------- sync & caching
SYNC_INTERVAL=15m
SYNC_LOCK_TTL=10m
SYNC_JOB_TIMEOUT=10m
SYNC_JOB_MAX_RETRIES=3
PRICE_CACHE_TTL=45s
PORTFOLIO_CACHE_TTL=2m

# Price freshness thresholds (§37). Anything above STALE is VERY_STALE.
FRESHNESS_FRESH_MAX=5m
FRESHNESS_RECENT_MAX=15m
FRESHNESS_STALE_MAX=60m

# ------------------------------------------------------------- rate limiting
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=240

# ----------------------------------------------------------------- worker
WORKER_CONCURRENCY=10
WORKER_SHUTDOWN_TIMEOUT=30s
